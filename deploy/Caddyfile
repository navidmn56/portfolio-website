{
    email {$CADDY_EMAIL}
}

{$DOMAIN} {

    encode gzip

    # ============================================================
    # Django static files
    # ============================================================
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # ============================================================
    # Uploaded media files
    # ============================================================
    handle_path /media/* {
        root * /srv/media
        file_server
    }

    # ============================================================
    # Django application
    # ============================================================
    handle {
        reverse_proxy web:8000
    }
}